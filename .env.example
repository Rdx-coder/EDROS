# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# EDROS Enterprise Configuration Parameters
# ==============================================================================

# Database Persistence Configuration (Relational PostgreSql Pool)
DATABASE_URL="postgresql://edros_admin:SecureAdminPassword@localhost:5432/edros_prod?sslmode=require"
DB_POOL_MIN=10
DB_POOL_MAX=50

# Redis Cache & Session Configuration
REDIS_URL="redis://:SecureRedisPassword@localhost:6379/0"
REDIS_CACHE_TTL_SECONDS=3600

# Security Credentials & Identity Boundaries
JWT_SECRET_KEY="replace_with_64_character_hex_key_for_production"
JWT_EXPIRY_DURATION="8h"
SECURITY_ENCRYPTION_KEY="replace_with_32_byte_aes_encryption_key"

# Operational Rate Limiting (Permitted requests per Window per identifier)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_RPM=120

# Structured Logging Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL="INFO"
LOG_FORMAT="JSON"

# Telemetry & Audit
APM_SERVICE_NAME="edros-core-engine"
APM_SERVER_URL="http://localhost:8200"
SENTRY_DSN="https://7243950cfca84824b26c7e29b1bead76@o4500000000000000.ingest.sentry.io/4500000000000000"

# ==============================================================================
# EDROS Secure Multi-Cloud Object Storage (AWS S3, R2, MinIO, Spaces, B2)
# ==============================================================================
STORAGE_PROVIDER="S3" # Supported adapters: S3, R2, MINIO, SPACES, B2
STORAGE_BUCKET="edros-secured-vault"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="your_access_key_id"
STORAGE_SECRET_ACCESS_KEY="your_secret_access_key"
STORAGE_ENDPOINT="" # Optional custom endpoint URL (MinIO, Backblaze B2, DigitalOcean Spaces)
STORAGE_ACCOUNT_ID="" # Optional Cloudflare Account ID (Required for R2 endpoint routing)
