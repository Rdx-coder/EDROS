# ==============================================================================
# EDROS (Debt Recovery Operating System) Enterprise Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Runtime Settings
# ------------------------------------------------------------------------------
# NODE_ENV: Identifies the execution runtime context. Bypasses Vite mounting when 'production'.
NODE_ENV="development"

# PORT: The ingress routing port where the application listens.
PORT=3000

# APP_URL: Fully qualified host URL of the deployment instance. Used for callbacks and references.
APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 2. Relational Database Engine (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# DATABASE_URL: Fully qualified PostgreSQL connection URI with credentials. (Required by Prisma)
DATABASE_URL="postgresql://edros_admin:SecureAdminPassword2026@localhost:5432/edros_prod?sslmode=disable"

# DB_POOL_MIN: Minimum number of physical database connections held in the thread pool.
DB_POOL_MIN=10

# DB_POOL_MAX: Maximum boundary of parallel database connections.
DB_POOL_MAX=50


# ------------------------------------------------------------------------------
# 3. Redis In-Memory Engine (Rate Limiting, Cache, & Sessions)
# ------------------------------------------------------------------------------
# REDIS_URL: Unified Redis server connection endpoint.
REDIS_URL="redis://:SecureRedisPassword2026@localhost:6379/0"

# REDIS_CACHE_TTL_SECONDS: Default TTL duration in seconds for caching data arrays.
REDIS_CACHE_TTL_SECONDS=3600


# ------------------------------------------------------------------------------
# 4. Cryptographic Operations & Session Identity (RBAC & JWT)
# ------------------------------------------------------------------------------
# JWT_SECRET: Critical secret token used for signing and verifying cryptographic user session claims.
# WARNING: Mismatching this key or using defaults in production exposes the system to session hijacking.
JWT_SECRET="replace_with_64_character_hex_key_for_production_signing_authority"

# JWT_EXPIRY_DURATION: Token duration before strict re-authentication is demanded.
JWT_EXPIRY_DURATION="8h"

# SECURITY_ENCRYPTION_KEY: Cryptographic key utilized for field-level database encryption.
SECURITY_ENCRYPTION_KEY="replace_with_32_byte_aes_encryption_key_in_hex_format"


# ------------------------------------------------------------------------------
# 5. Observability, Metrics, & Diagnostic Logging
# ------------------------------------------------------------------------------
# LOG_LEVEL: Verbosity indicator. Supported adapters: DEBUG, INFO, WARN, ERROR.
LOG_LEVEL="INFO"

# LOG_FORMAT: Serialization type of logging outputs. Supported: JSON, TEXT.
LOG_FORMAT="JSON"

# SENTRY_DSN: Data Source Name endpoint for reporting telemetry exceptions to Sentry.
SENTRY_DSN="https://7243950cfca84824b26c7e29b1bead76@o4500000000000000.ingest.sentry.io/4500000000000000"

# APM_SERVICE_NAME: The logical registry name of this application microservice.
APM_SERVICE_NAME="edros-core-engine"

# APM_SERVER_URL: Endpoint host routing path to Elastic APM or similar collectors.
APM_SERVER_URL="http://localhost:8200"


# ------------------------------------------------------------------------------
# 6. Secure Unified Object Storage (Multi-Cloud S3 Compatible Gateway)
# ------------------------------------------------------------------------------
# STORAGE_PROVIDER: Active storage provider. Supported: S3, R2, MINIO, SPACES, B2.
STORAGE_PROVIDER="S3"

# STORAGE_BUCKET: Active bucket or root directory name inside the storage ecosystem.
STORAGE_BUCKET="edros-secured-vault"

# STORAGE_REGION: Datacenter region mapping.
STORAGE_REGION="us-east-1"

# STORAGE_ACCESS_KEY_ID: API gateway access key credential identifier.
STORAGE_ACCESS_KEY_ID="your_storage_access_key_id"

# STORAGE_SECRET_ACCESS_KEY: API gateway secret key credential signature.
STORAGE_SECRET_ACCESS_KEY="your_storage_secret_access_key"

# STORAGE_ENDPOINT: Custom target URL endpoint for non-AWS services (MinIO, R2, DigitalOcean).
STORAGE_ENDPOINT=""

# STORAGE_ACCOUNT_ID: Account ID mapping key (primarily required for Cloudflare R2 path configurations).
STORAGE_ACCOUNT_ID=""


# ------------------------------------------------------------------------------
# 7. Cloud-Native Provider Fallbacks & Monitoring Targets
# ------------------------------------------------------------------------------
# AWS_REGION: Datacenter region used specifically by fallback S3 clients.
AWS_REGION="us-east-1"

# AWS_ACCESS_KEY_ID: Direct IAM Access key identifier for S3 backups/uploads.
AWS_ACCESS_KEY_ID="your_aws_access_key_id"

# AWS_SECRET_ACCESS_KEY: Direct IAM Secret signature key for S3.
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"

# AWS_S3_ENDPOINT: Custom local / mock endpoints for S3 compatible wrappers (LocalStack).
AWS_S3_ENDPOINT=""

# AWS_S3_BUCKET: Active AWS S3 bucket verified by the system's diagnostics.
AWS_S3_BUCKET="edros-secured-vault"

# R2_ACCOUNT_ID: Cloudflare endpoint resolver routing account key.
R2_ACCOUNT_ID=""

# CLOUDFLARE_R2_BUCKET: Cloudflare R2 bucket name verified by active API health systems.
CLOUDFLARE_R2_BUCKET="edros-secured-vault"

# MINIO_BUCKET: Local MinIO container bucket verified by active API health systems.
MINIO_BUCKET="edros-secured-vault"

# MINIO_ENDPOINT: Connection URL pointing to custom MinIO local services.
MINIO_ENDPOINT="http://localhost:9000"


# ------------------------------------------------------------------------------
# 8. Development & Framework parameters
# ------------------------------------------------------------------------------
# DISABLE_HMR: Disables Vite Hot Module Replacement to prevent unnecessary container refreshing.
DISABLE_HMR="false"


# ------------------------------------------------------------------------------
# 9. Artificial Intelligence Integrations (Gemini API SDK)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Authentication token used for executing server-side Gemini AI models.
GEMINI_API_KEY="your_private_gemini_api_key_from_google_ai_studio"
