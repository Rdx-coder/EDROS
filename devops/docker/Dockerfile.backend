# Dockerfile.backend
# Multi-stage production container build for EDROS Core Engine (Express Server)

# --- Stage 1: Build & Compilation ---
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

COPY package*.json ./
COPY prisma ./prisma/
RUN npm ci

COPY . .

# Run production compilation of client assets and node backend
RUN npm run build

# --- Stage 2: Minimalist Lean Production Image ---
FROM node:20-alpine AS runner

ENV NODE_ENV=production
WORKDIR /usr/src/app

# Create a secure, rootless system user
RUN addgroup -g 1001 -S nodejs && \
    adduser -u 1001 -S nodejs -G nodejs

COPY --chown=nodejs:nodejs package*.json ./
COPY --chown=nodejs:nodejs prisma ./prisma/
RUN npm ci --only=production

# Explicitly generate Prisma Client to ensure it is built in the runner stage with correct binary engine
RUN npx prisma generate

# Copy compiled backend bundle and assets from stage 1
COPY --chown=nodejs:nodejs --from=builder /usr/src/app/dist ./dist

# Recursively change ownership of application folder to non-root user
RUN chown -R nodejs:nodejs /usr/src/app

# Expose port 3000
EXPOSE 3000

# Set user privilege levels
USER nodejs

# Run pending migrations and start compiled CommonJS server bundle
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/server.cjs"]
