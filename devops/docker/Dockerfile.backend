# Dockerfile.backend
# Multi-stage production container build for EDROS Core Engine (Express Server)

# --- Stage 1: Build & Compilation ---
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm ci

COPY . .

# Run production compilation of client assets and node backend
RUN npm run build

# --- Stage 2: Minimalist Lean Production Image ---
FROM node:20-alpine AS runner

ENV NODE_ENV=production
WORKDIR /usr/src/app

# Create a secure, rootless system user
RUN addgroup -g 1001 -S nodejs && \
    adduser -u 1001 -S nodejs -G nodejs

COPY --chown=nodejs:nodejs package*.json ./
RUN npm ci --only=production

# Copy compiled backend bundle and assets from stage 1
COPY --chown=nodejs:nodejs --from=builder /usr/src/app/dist ./dist
COPY --chown=nodejs:nodejs --from=builder /usr/src/app/prisma ./prisma

# Expose port 3000
EXPOSE 3000

# Set user privilege levels
USER nodejs

# Launch compiled CommonJS bundle
CMD ["node", "dist/server.cjs"]
