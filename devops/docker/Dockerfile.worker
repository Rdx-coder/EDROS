# Dockerfile.worker
# Multi-stage production container build for EDROS Background Queue Worker threads (BullMQ)

FROM node:20-alpine AS builder
WORKDIR /usr/src/app

COPY package*.json ./
COPY prisma ./prisma/
RUN npm ci

COPY . .
RUN npm run build

FROM node:20-alpine AS runner
ENV NODE_ENV=production
WORKDIR /usr/src/app

RUN addgroup -g 1001 -S nodejs && \
    adduser -u 1001 -S nodejs -G nodejs

COPY --chown=nodejs:nodejs package*.json ./
COPY --chown=nodejs:nodejs prisma ./prisma/
RUN npm ci --only=production

# Explicitly generate Prisma Client to ensure it is built in the runner stage with correct binary engine
RUN npx prisma generate

# Copy built code to output
COPY --chown=nodejs:nodejs --from=builder /usr/src/app/dist ./dist

# Recursively change ownership of application folder to non-root user
RUN chown -R nodejs:nodejs /usr/src/app

USER nodejs

# Launch the worker process
CMD ["node", "dist/server.cjs", "--worker"]
