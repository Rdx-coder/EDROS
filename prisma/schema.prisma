// prisma/schema.prisma
//
// EDROS (Debt Recovery Operating System) Enterprise Relational Database Blueprint
// Configured with UUID keys, Soft Delete constraints, strict Multi-Tenant & Multi-Bank isolation,
// and high-density normalization (100+ tables) for Financial, Employee, Payroll, Legal, and Case workflows.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. MULTI-TENANT & ORGANIZATION HIERARCHY (7 TABLES)
// ==========================================

model Tenant {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(255)
  code      String    @unique @db.VarChar(50)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isDeleted Boolean   @default(false) @map("is_deleted")

  banks         Bank[]
  states        StateHierarchy[]
  users         User[]
  auditLogs     AuditLog[]
  telemetry     SystemTelemetry[]
  settings      AppSetting[]
  recoveryCases RecoveryCase[]

  @@index([code])
  @@index([isDeleted])
  @@map("tenants")
}

model Bank {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(255)
  code      String    @db.VarChar(50)
  logoUrl   String?   @map("logo_url") @db.VarChar(500)
  status    String    @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isDeleted Boolean   @default(false) @map("is_deleted")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches    BankBranch[]
  loans       Loan[]
  commissions BankCommission[]
  cases       RecoveryCase[]

  @@unique([tenantId, code])
  @@index([isDeleted])
  @@map("banks")
}

model StateHierarchy {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(100)
  code      String    @db.VarChar(10)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isDeleted Boolean   @default(false) @map("is_deleted")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  regions   RegionHierarchy[]
  employees Employee[]

  @@unique([tenantId, code])
  @@map("state_hierarchies")
}

model RegionHierarchy {
  id        String    @id @default(uuid()) @db.Uuid
  stateId   String    @map("state_id") @db.Uuid
  name      String    @db.VarChar(100)
  code      String    @db.VarChar(10)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isDeleted Boolean   @default(false) @map("is_deleted")

  state     StateHierarchy    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  branches  BranchHierarchy[]
  employees Employee[]

  @@unique([stateId, code])
  @@map("region_hierarchies")
}

model BranchHierarchy {
  id        String    @id @default(uuid()) @db.Uuid
  regionId  String    @map("region_id") @db.Uuid
  name      String    @db.VarChar(100)
  code      String    @db.VarChar(10)
  address   String    @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isDeleted Boolean   @default(false) @map("is_deleted")

  region    RegionHierarchy @relation(fields: [regionId], references: [id], onDelete: Cascade)
  teams     TeamHierarchy[]
  employees Employee[]

  @@unique([regionId, code])
  @@map("branch_hierarchies")
}

model BankBranch {
  id        String    @id @default(uuid()) @db.Uuid
  bankId    String    @map("bank_id") @db.Uuid
  name      String    @db.VarChar(255)
  ifscCode  String    @map("ifsc_code") @db.VarChar(20)
  city      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isDeleted Boolean   @default(false) @map("is_deleted")

  bank  Bank   @relation(fields: [bankId], references: [id], onDelete: Cascade)
  loans Loan[]

  @@unique([bankId, ifscCode])
  @@map("bank_branches")
}

model TeamHierarchy {
  id        String    @id @default(uuid()) @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  name      String    @db.VarChar(100)
  code      String    @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isDeleted Boolean   @default(false) @map("is_deleted")

  branch    BranchHierarchy @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([branchId, code])
  @@map("team_hierarchies")
}

// ==========================================
// 2. IDENTITY, AUTHENTICATION, SESSIONS, SECURITY & RBAC (10 TABLES)
// ==========================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  username     String    @db.VarChar(150)
  email        String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  isDeleted    Boolean   @default(false) @map("is_deleted")

  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee              Employee?
  sessions              Session[]
  otps                  OtpCode[]
  roles                 EmployeeRole[]
  auditLogs             AuditLog[]
  sentNotifications     Notification[] @relation("Sender")
  receivedNotifications Notification[] @relation("Recipient")
  activityLogs          ActivityLog[]

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([isDeleted])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  userRoles   EmployeeRole[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(100)
  module    String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model EmployeeRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("employee_roles")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(500)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(500)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  telemetries SessionTelemetry[]

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model OtpCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  code      String    @db.VarChar(6)
  purpose   String    @db.VarChar(50)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_codes")
}

model IpWhitelist {
  id        String   @id @default(uuid()) @db.Uuid
  ipAddress String   @unique @map("ip_address") @db.VarChar(45)
  label     String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ip_whitelists")
}

model RateLimitLog {
  id          String   @id @default(uuid()) @db.Uuid
  ipAddress   String   @map("ip_address") @db.VarChar(45)
  endpoint    String   @db.VarChar(255)
  hits        Int
  windowStart DateTime @map("window_start")
  blocked     Boolean  @default(false)

  @@index([ipAddress, windowStart])
  @@map("rate_limit_logs")
}

model AppSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     String   @db.Text
  group     String   @default("GENERAL") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("app_settings")
}

// ==========================================
// 3. AUDIT TRAILS & SYSTEM TELEMETRY (5 TABLES)
// ==========================================

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  userEmail     String   @map("user_email") @db.VarChar(255)
  userRole      String   @map("user_role") @db.VarChar(100)
  action        String   @db.VarChar(100)
  resource      String   @db.VarChar(100)
  resourceId    String?  @map("resource_id") @db.VarChar(100)
  ipAddress     String   @map("ip_address") @db.VarChar(45)
  userAgent     String   @map("user_agent") @db.VarChar(500)
  correlationId String   @map("correlation_id") @db.Uuid
  status        String   @db.VarChar(20)
  payload       String?  @db.Text
  timestamp     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([correlationId])
  @@index([timestamp])
  @@map("audit_logs")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  actionType String   @map("action_type") @db.VarChar(100)
  details    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activity_logs")
}

model SystemTelemetry {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  metricName  String   @map("metric_name") @db.VarChar(100)
  metricValue Float    @map("metric_value")
  recordedAt  DateTime @default(now()) @map("recorded_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, metricName])
  @@map("system_telemetry")
}

model ServerMetric {
  id         String   @id @default(uuid()) @db.Uuid
  cpuUsage   Float    @map("cpu_usage")
  ramUsage   Float    @map("ram_usage")
  activeReqs Int      @map("active_requests")
  measuredAt DateTime @default(now()) @map("measured_at")

  @@map("server_metrics")
}

model SessionTelemetry {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  actionTime DateTime @default(now()) @map("action_time")
  durationMs Int      @map("duration_ms")
  pagePath   String   @map("page_path") @db.VarChar(500)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_telemetries")
}

// ==========================================
// 4. EMPLOYEE MANAGEMENT, HR, ATTENDANCE & PAYROLL (10 TABLES)
// ==========================================

model Employee {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  stateId       String?   @map("state_id") @db.Uuid
  regionId      String?   @map("region_id") @db.Uuid
  branchId      String?   @map("branch_id") @db.Uuid
  teamId        String?   @map("team_id") @db.Uuid
  reportingToId String?   @map("reporting_to_id") @db.Uuid
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String    @map("last_name") @db.VarChar(100)
  phone         String    @db.VarChar(50)
  departmentId  String    @map("department_id") @db.Uuid
  jobTitleId    String    @map("job_title_id") @db.Uuid
  statusId      String    @map("status_id") @db.Uuid
  joinedDate    DateTime  @map("joined_date")
  leftDate      DateTime? @map("left_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  state        StateHierarchy?  @relation(fields: [stateId], references: [id])
  region       RegionHierarchy? @relation(fields: [regionId], references: [id])
  branch       BranchHierarchy? @relation(fields: [branchId], references: [id])
  team         TeamHierarchy?   @relation(fields: [teamId], references: [id])
  department   Department       @relation(fields: [departmentId], references: [id])
  jobTitle     JobTitle         @relation(fields: [jobTitleId], references: [id])
  status       EmployeeStatus   @relation(fields: [statusId], references: [id])
  manager      Employee?        @relation("ReportingChain", fields: [reportingToId], references: [id])
  subordinates Employee[]       @relation("ReportingChain")

  attendances   Attendance[]
  gpsLocations  GpsLocation[]
  leaveRequests LeaveRequest[]
  payslips      PaySlip[]
  incentives    AgentIncentive[]
  allocations   CaseAllocation[]
  fieldVisits   FieldVisit[]

  @@index([branchId])
  @@index([teamId])
  @@map("employees")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  employees Employee[]

  @@map("departments")
}

model JobTitle {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  grade     String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  employees Employee[]

  @@map("job_titles")
}

model EmployeeStatus {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  label     String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  employees Employee[]

  @@map("employee_statuses")
}

model Attendance {
  id                String    @id @default(uuid()) @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  workDate          DateTime  @map("work_date") @db.Date
  clockIn           DateTime? @map("clock_in")
  clockOut          DateTime? @map("clock_out")
  status            String    @default("PRESENT") @db.VarChar(20) // PRESENT, ABSENT, LEAVE, HALF_DAY
  deviceFingerprint String?   @map("device_fingerprint") @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workDate])
  @@map("attendances")
}

model WorkShift {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  startTime String   @map("start_time") @db.VarChar(5) // HH:MM
  endTime   String   @map("end_time") @db.VarChar(5) // HH:MM
  graceMins Int      @default(15) @map("grace_mins")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("work_shifts")
}

model LeaveRequest {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  leaveType    String   @map("leave_type") @db.VarChar(50) // CASUAL, SICK, EARNED
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  reason       String   @db.VarChar(500)
  status       String   @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  approvedById String?  @map("approved_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model HolidayCalendar {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  holidayDate DateTime @map("holiday_date") @db.Date
  isNational  Boolean  @default(true) @map("is_national")
  stateCode   String?  @map("state_code") @db.VarChar(10)

  @@unique([holidayDate, stateCode])
  @@map("holiday_calendars")
}

model MonthlyAttendanceSummary {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  yearMonth    String   @map("year_month") @db.VarChar(7) // YYYY-MM
  presents     Int      @default(0)
  absents      Int      @default(0)
  leaves       Int      @default(0)
  halfDays     Int      @default(0)
  lates        Int      @default(0)
  calculatedAt DateTime @default(now()) @map("calculated_at")

  @@unique([employeeId, yearMonth])
  @@map("monthly_attendance_summaries")
}

model PaySlip {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  monthYear      String    @map("month_year") @db.VarChar(7) // YYYY-MM
  baseSalary     Decimal   @map("base_salary") @db.Decimal(15, 2)
  incentivePaid  Decimal   @default(0.00) @map("incentive_paid") @db.Decimal(15, 2)
  deductions     Decimal   @default(0.00) @db.Decimal(15, 2)
  netPaid        Decimal   @map("net_paid") @db.Decimal(15, 2)
  paymentStatus  String    @default("UNPAID") @db.VarChar(20) // PAID, UNPAID, HOLD
  paidDate       DateTime? @map("paid_date")
  transactionRef String?   @map("transaction_ref") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, monthYear])
  @@map("payslips")
}

// ==========================================
// 5. NOTIFICATION SYSTEM & COMMUNICATOR (4 TABLES)
// ==========================================

model NotificationTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(100)
  channel   String   @db.VarChar(20) // IN_APP, EMAIL, SMS, WHATSAPP
  subject   String?  @db.VarChar(255)
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  notifications Notification[]

  @@map("notification_templates")
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  templateId  String?   @map("template_id") @db.Uuid
  senderId    String?   @map("sender_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  channel     String    @db.VarChar(20)
  subject     String?   @db.VarChar(255)
  body        String    @db.Text
  status      String    @default("UNREAD") @db.VarChar(20) // UNREAD, READ, FAILED, SENT
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  template  NotificationTemplate? @relation(fields: [templateId], references: [id])
  sender    User?                 @relation("Sender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient User                  @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@map("notifications")
}

model SmsGatewayLog {
  id         String   @id @default(uuid()) @db.Uuid
  phone      String   @db.VarChar(50)
  message    String   @db.Text
  status     String   @db.VarChar(20) // SENT, FAILED
  provider   String   @db.VarChar(50)
  providerId String?  @map("provider_id") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("sms_gateway_logs")
}

model EmailGatewayLog {
  id         String   @id @default(uuid()) @db.Uuid
  recipient  String   @db.VarChar(255)
  subject    String   @db.VarChar(255)
  status     String   @db.VarChar(20)
  providerId String?  @map("provider_id") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("email_gateway_logs")
}

// ==========================================
// 6. CUSTOMER & DEBTOR ENTITIES (5 TABLES)
// ==========================================

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  fullName  String    @map("full_name") @db.VarChar(255)
  panCard   String?   @unique @map("pan_card") @db.VarChar(20)
  aadhaarId String?   @unique @map("aadhaar_id") @db.VarChar(20)
  email     String?   @db.VarChar(255)
  phone     String    @db.VarChar(50)
  dob       DateTime? @db.Date
  status    String    @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  isDeleted Boolean   @default(false) @map("is_deleted")

  addresses   CustomerAddress[]
  documents   CustomerDocument[]
  bankDetails CustomerBankDetails[]
  loans       Loan[]

  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  addressType String   @map("address_type") @db.VarChar(20) // RESIDENCE, OFFICE, PERMANENT
  line1       String   @map("line_1") @db.VarChar(255)
  line2       String?  @map("line_2") @db.VarChar(255)
  city        String   @db.VarChar(100)
  state       String   @db.VarChar(100)
  postalCode  String   @map("postal_code") @db.VarChar(20)
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model CustomerBankDetails {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
