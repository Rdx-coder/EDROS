  courierTrackingNo String?   @map("courier_tracking_no") @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at")

  recoveryCase RecoveryCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  template     LegalNoticeTemplate @relation(fields: [templateId], references: [id])
  litigations  LitigationCase[]

  @@map("legal_notices")
}

model LitigationCase {
  id              String    @id @default(uuid()) @db.Uuid
  noticeId        String?   @map("notice_id") @db.Uuid
  suitNumber      String    @unique @map("suit_number") @db.VarChar(100)
  courtId         String    @map("court_id") @db.Uuid
  filingDate      DateTime  @map("filing_date")
  nextHearingDate DateTime? @map("next_hearing_date")
  suitStatus      String    @default("FILED") @db.VarChar(50) // FILED, ARGUMENTS, DECREE_PASSED, CLOSED
  natureOfSuit    String    @map("nature_of_suit") @db.VarChar(100) // CIVIL_SUIT, INSOLVENCY, CRIMINAL_CHQ_BOUNCE
  decreeAmount    Decimal?  @map("decree_amount") @db.Decimal(15, 2)
  decreeDate      DateTime? @map("decree_date")
  createdAt       DateTime  @default(now()) @map("created_at")

  notice             LegalNotice?        @relation(fields: [noticeId], references: [id], onDelete: SetNull)
  court              Court               @relation(fields: [courtId], references: [id])
  hearings           CourtHearing[]
  executionPetitions ExecutionPetition[]
  litigationCounsels LegalCounselCase[]

  @@map("litigation_cases")
}

model Court {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(255)
  courtDistrictId String   @map("court_district_id") @db.Uuid
  courtType       String   @map("court_type") @db.VarChar(50) // HIGH_COURT, DEBT_RECOVERY_TRIBUNAL, DISTRICT_COURT
  bench           String?  @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at")

  district CourtDistrict    @relation(fields: [courtDistrictId], references: [id])
  rooms    CourtRoom[]
  cases    LitigationCase[]

  @@map("courts")
}

model CourtDistrict {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  stateCode String   @map("state_code") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  courts Court[]

  @@map("court_districts")
}

model CourtRoom {
  id        String   @id @default(uuid()) @db.Uuid
  courtId   String   @map("court_id") @db.Uuid
  roomNo    String   @map("room_no") @db.VarChar(20)
  floor     Int?
  createdAt DateTime @default(now()) @map("created_at")

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("court_rooms")
}

model JudgeProfile {
  id          String    @id @default(uuid()) @db.Uuid
  fullName    String    @map("full_name") @db.VarChar(255)
  salutation  String    @db.VarChar(20)
  joinedDate  DateTime  @map("joined_date") @db.Date
  retiredDate DateTime? @map("retired_date") @db.Date

  @@map("judge_profiles")
}

model LegalCounselCase {
  counselId String @map("counsel_id") @db.Uuid
  caseId    String @map("case_id") @db.Uuid
  roleType  String @map("role_type") @db.VarChar(50) // LEAD_ADVOCATE, ASSISTANT_ADVOCATE

  case LitigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@id([counselId, caseId])
  @@map("legal_counsel_cases")
}

model CourtHearing {
  id               String   @id @default(uuid()) @db.Uuid
  litigationCaseId String   @map("litigation_case_id") @db.Uuid
  hearingDate      DateTime @map("hearing_date")
  judgeNotes       String?  @map("judge_notes") @db.Text
  counselPresent   Boolean  @default(true) @map("counsel_present")
  hearingStatus    String   @default("SCHEDULED") @db.VarChar(20) // SCHEDULED, ADJOURNED, HEARD
  createdAt        DateTime @default(now()) @map("created_at")

  litigationCase LitigationCase    @relation(fields: [litigationCaseId], references: [id], onDelete: Cascade)
  adjournments   CaseAdjournment[]

  @@map("court_hearings")
}

model CaseAdjournment {
  id           String   @id @default(uuid()) @db.Uuid
  hearingId    String   @map("hearing_id") @db.Uuid
  reasonCode   String   @map("reason_code") @db.VarChar(50) // OPPONENT_ABSENT, JUDGE_LEAVE, ADVOCATE_UNWELL
  extendedDate DateTime @map("extended_date")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  hearing CourtHearing @relation(fields: [hearingId], references: [id], onDelete: Cascade)

  @@map("case_adjournments")
}

model ExecutionPetition {
  id               String   @id @default(uuid()) @db.Uuid
  litigationCaseId String   @map("litigation_case_id") @db.Uuid
  epNo             String   @unique @map("ep_no") @db.VarChar(100)
  filedDate        DateTime @map("filed_date")
  warrantIssued    Boolean  @default(false) @map("warrant_issued")
  warrantDetails   String?  @map("warrant_details") @db.Text
  status           String   @default("FILED") @db.VarChar(20)

  litigationCase LitigationCase @relation(fields: [litigationCaseId], references: [id], onDelete: Cascade)

  @@map("execution_petitions")
}

model LegalNoticeDelivery {
  id          String   @id @default(uuid()) @db.Uuid
  noticeId    String   @map("notice_id") @db.Uuid
  attemptDate DateTime @map("attempt_date")
  status      String   @db.VarChar(20) // SERVED, ATTEMPTED_HOUSE_LOCKED, ATTEMPTED_REFUSED
  remarks     String?  @db.VarChar(255)

  @@map("legal_notice_deliveries")
}

// ==========================================
// 14. DOCUMENT MASTER & ACCESS CONTROL (5 TABLES)
// ==========================================

model DocumentCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  documents DocumentMaster[]

  @@map("document_categories")
}

model DocumentMaster {
  id             String   @id @default(uuid()) @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  title          String   @db.VarChar(255)
  storagePath    String   @map("storage_path") @db.VarChar(500)
  fileSizeKb     Int      @map("file_size_kb")
  fileType       String   @map("file_type") @db.VarChar(10)
  sha256Checksum String   @map("sha256_checksum") @db.VarChar(64)
  uploadedById   String   @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  isDeleted      Boolean  @default(false) @map("is_deleted")

  category       DocumentCategory        @relation(fields: [categoryId], references: [id])
  casesMap       CaseDocumentMap[]
  customerMap    CustomerDocument[]
  accessControls DocumentAccessControl[]

  @@map("document_masters")
}

model DocumentAccessControl {
  documentId String  @map("document_id") @db.Uuid
  roleName   String  @map("role_name") @db.VarChar(100)
  canRead    Boolean @default(true) @map("can_read")
  canWrite   Boolean @default(false) @map("can_write")

  document DocumentMaster @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, roleName])
  @@map("document_access_controls")
}

model CaseDocumentMap {
  caseId     String @map("case_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid

  document DocumentMaster @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([caseId, documentId])
  @@map("case_document_maps")
}

model CustomerDocument {
  customerId String @map("customer_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  document DocumentMaster @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([customerId, documentId])
  @@map("customer_documents")
}

// ==========================================
// 15. BACKGROUND WORKFLOWS & WORKER QUEUES (4 TABLES)
// ==========================================

model BackgroundJob {
  id         String    @id @default(uuid()) @db.Uuid
  jobType    String    @map("job_type") @db.VarChar(100) // BULK_IMPORT, COMPILED_REPORT, DATA_ANONYMIZATION
  payload    String    @db.Text
  status     String    @default("QUEUED") @db.VarChar(20) // QUEUED, RUNNING, COMPLETED, FAILED
  progress   Int       @default(0)
  errorLog   String?   @map("error_log") @db.Text
  queuedAt   DateTime  @default(now()) @map("queued_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@map("background_jobs")
}

model RedisQueueLog {
  id           String   @id @default(uuid()) @db.Uuid
  queueName    String   @map("queue_name") @db.VarChar(100)
  messageId    String   @map("message_id") @db.VarChar(100)
  eventPayload String   @map("event_payload") @db.Text
  processedAt  DateTime @default(now()) @map("processed_at")

  @@map("redis_queue_logs")
}

model BulkImportSession {
  id           String   @id @default(uuid()) @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  fileSizeKb   Int      @map("file_size_kb")
  rowCount     Int      @map("row_count")
  successCount Int      @default(0) @map("success_count")
  errorCount   Int      @default(0) @map("error_count")
  status       String   @default("PROCESSING") @db.VarChar(20) // PROCESSING, COMPLETED, FAILED
  errorsJson   String?  @map("errors_json") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("bulk_import_sessions")
}

model BulkExportSession {
  id             String   @id @default(uuid()) @db.Uuid
  filterCriteria String   @map("filter_criteria") @db.Text
  filePath       String?  @map("file_path") @db.VarChar(500)
  status         String   @default("QUEUED") @db.VarChar(20) // QUEUED, COMPLETED, FAILED
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("bulk_export_sessions")
}

// ==========================================
// 16. SYSTEM DASHBOARD CONFIGURATIONS (2 TABLES)
// ==========================================

model SystemDashboardConfig {
  id           String   @id @default(uuid()) @db.Uuid
  roleName     String   @unique @map("role_name") @db.VarChar(100)
  layoutJson   String   @map("layout_json") @db.Text
  enabledCards String   @map("enabled_cards") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("system_dashboard_configs")
}

model DashboardWidget {
  id        String   @id @default(uuid()) @db.Uuid
  widgetKey String   @unique @map("widget_key") @db.VarChar(100)
  title     String   @db.VarChar(100)
  chartType String   @map("chart_type") @db.VarChar(50) // BARS, PIE, LINE, METRIC
  querySql  String   @map("query_sql") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("dashboard_widgets")
}
